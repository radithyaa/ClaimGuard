# Salin ke .env (jangan di-commit). Semua nilai opsional untuk dev lokal.

# --- Lokal ---
ENV=local
DATABASE_URL=sqlite:///./claimguard.db
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
# FFMPEG_PATH=        # kosong: ffmpeg di PATH, lalu imageio-ffmpeg

# --- Auth demo (FR-19) ---
AUTH_REQUIRED=false
DEMO_PASSWORD=claimguard-demo
SESSION_SECRET=dev-only-secret-ganti-di-cloud

# --- AI: Vertex AI lewat service account/ADC (tanpa API key) ---
# Cukup isi GCP_PROJECT; env GOOGLE_GENAI_USE_VERTEXAI dkk. untuk ADK diset otomatis.
GCP_PROJECT=
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash        # terverifikasi tersedia di project panitia (21 Okt 2026);
                                     # "gemini-flash-latest" TIDAK punya alias di Vertex
AI_MODE=auto                       # live | auto | cache (bisa diubah lewat PATCH /settings)
MIN_CONFIDENCE=0.6

# --- Monitoring ---
SCHEDULER_ENABLED=false            # biarkan false saat demo
SCAN_INTERVAL_MIN=5
SLA_GRACE_HOURS=0

# --- Cloud Run (diisi lewat --set-env-vars / Secret Manager, bukan di repo) ---
# ENV=cloud
# AUTH_REQUIRED=true
# DATABASE_URL=postgresql+psycopg://claimguard:PASSWORD@/claimguard?host=/cloudsql/PROJECT:REGION:claimguard-db
# STORAGE_BACKEND=gcs
# GCS_BUCKET=PROJECT-claimguard-media
# CORS_ORIGINS=["https://claimguard-web-xxxx.a.run.app"]
# DEMO_PASSWORD / SESSION_SECRET dari Secret Manager

# Lokal
ENV=local
DATABASE_URL=sqlite:///./claimguard.db
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:8000
# FFMPEG_PATH=        # kosong: pakai ffmpeg di PATH, lalu imageio-ffmpeg

# Cloud Run (diisi saat deploy, bukan di repo)
# ENV=cloud
# DATABASE_URL=postgresql+psycopg://USER:PASS@/claimguard?host=/cloudsql/PROJECT:REGION:INSTANCE
# STORAGE_BACKEND=gcs
# GCS_BUCKET=

# AI — Vertex AI lewat service account (tanpa API key)
GCP_PROJECT=
GCP_LOCATION=global
GEMINI_MODEL=gemini-flash-latest   # verifikasi nama model di Vertex saat billing aktif
AI_MODE=auto                       # live | auto | cache
MIN_CONFIDENCE=0.6
# Dibaca ADK untuk model agen:
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

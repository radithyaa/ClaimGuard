# Env non-rahasia Cloud Run. Salin ke env.cloud.yaml (di-gitignore) lalu isi.
GCP_PROJECT: "PROJECT"
GCP_LOCATION: "global"
GEMINI_MODEL: "MODEL-DARI-VERTEX"
GCS_BUCKET: "PROJECT-claimguard-media"
AUTH_REQUIRED: "true"
AI_MODE: "auto"
PUBLIC_BASE_URL: "https://URL-API-CLOUD-RUN"
CORS_ORIGINS: '["https://URL-FRONTEND-CLOUD-RUN"]'
